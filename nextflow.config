conda.enabled = true

process {
    withName: FASTQC_RAW {
        conda = '/home/saihan24/miniconda3/envs/NGS'
    }

    withName: FASTQC_TRIMMED {
        conda = '/home/saihan24/miniconda3/envs/NGS'
    }

    withName: FASTP_TRIM {
        conda = '/home/saihan24/miniconda3/envs/NGS'
    }

    withName: SPADES_ASSEMBLY {
        conda = '/home/saihan24/miniconda3'
    }

    withName: QUAST_ASSEMBLY {
        conda = '/home/saihan24/miniconda3/envs/quast311'
    }
    
    withName: BUSCO_COMPLETENESS {
       beforeScript = 'export PATH=/home/saihan24/miniconda3/envs/busco-clean/bin:$PATH'
       conda = '/home/saihan24/miniconda3/envs/busco-clean'
    }
    withName: PROKKA_ANNOTATION {
       conda = '/home/saihan24/miniconda3/envs/prokka-env'
    }

}
